<?xml version="1.0"?>
<!--
  Staging instance of Drone Unit Manager.

  Tracks the :main channel, so every merge to main lands here on the next pull,
  while the production container tracks a cut release (:latest or :X.Y.Z) and
  only moves when someone decides to ship.

  Runs alongside production on a different port and a different appdata path, so
  the two share nothing.

  BEFORE FIRST START, if you seeded the appdata from a copy of production:
  that copy carries production's settings, which includes the SMTP credentials
  and the Skydio API token. Left alone, this instance will run its own nightly
  backup, sync Skydio again on the same schedule, and send the email digest to
  real recipients. Either clear those in Settings the moment it comes up, or
  neuter them in the copied database first:

    docker run --rm \
      -v /mnt/user/appdata/drone-unit-manager-staging:/app/data \
      --entrypoint python \
      ghcr.io/jongaydos/drone-unit-manager:main \
      -c "import sqlite3; c=sqlite3.connect('/app/data/drone_unit_manager.db'); \
          c.execute(\"DELETE FROM settings WHERE key IN ('smtp_host','smtp_username','smtp_password','skydio_api_token','skydio_token_id')\"); \
          c.execute(\"UPDATE settings SET value='false' WHERE key='backup_enabled'\"); \
          c.execute(\"UPDATE settings SET value='0' WHERE key IN ('sync_interval','telemetry_sync_interval')\"); \
          c.commit(); print('cleared', c.total_changes, 'rows')"

  The email digest is the one that reaches other people. Do this before you
  start the container, not after.
-->
<Container version="2">
  <Name>DroneUnitManager-Staging</Name>
  <Repository>ghcr.io/jongaydos/drone-unit-manager:main</Repository>
  <Registry>https://github.com/JonGaydos/Drone-Unit-Manager/pkgs/container/drone-unit-manager</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/JonGaydos/Drone-Unit-Manager/issues</Support>
  <Project>https://github.com/JonGaydos/Drone-Unit-Manager</Project>
  <Overview>
    Staging instance of Drone Unit Manager, tracking the :main channel. Every merge to main lands here, so changes can be exercised against a copy of real data before a release is cut and production moves. Runs on its own port and its own appdata directory; it shares nothing with the production container. If its appdata was seeded from production, clear the SMTP credentials and Skydio token before first start, or it will email real recipients and sync the real Skydio account on a schedule.
  </Overview>
  <Category>Tools: Productivity:</Category>
  <WebUI>http://[IP]:[PORT:3015]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/JonGaydos/Drone-Unit-Manager/main/frontend/public/icon.png</Icon>
  <ExtraParams>--restart unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI Port" Target="8000" Default="3015" Mode="tcp" Description="Port for the staging web interface. Must differ from the production container's." Type="Port" Display="always" Required="true" Mask="false">3015</Config>
  <Config Name="App Data" Target="/app/data" Default="/mnt/user/appdata/drone-unit-manager-staging" Mode="rw" Description="Staging data directory. Must be a different path from the production container's, or the two will fight over the same database." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/drone-unit-manager-staging</Config>
  <Config Name="Timezone" Target="TZ" Default="America/Chicago" Mode="" Description="Timezone for the application (e.g., America/New_York, America/Los_Angeles)" Type="Variable" Display="always" Required="false" Mask="false">America/Chicago</Config>
  <Config Name="Secret Key" Target="SECRET_KEY" Default="" Mode="" Description="JWT signing secret. Leave blank to auto-generate, so staging sessions are independent of production's." Type="Variable" Display="advanced" Required="false" Mask="true"/>
</Container>
