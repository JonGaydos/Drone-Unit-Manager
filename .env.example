# Drone Unit Manager Configuration
# Copy this file to .env and modify as needed

# Application port (default: 3014)
PORT=3014

# Secret key for JWT tokens (auto-generated if not set)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Timezone (default: America/Chicago)
TZ=America/Chicago

# Default admin password (only used on first run)
# ADMIN_DEFAULT_PASSWORD=admin

# Reverse proxy or tunnel addresses (comma-separated IPs or CIDRs) whose
# X-Forwarded-For and CF-Connecting-IP headers are trusted. Leave blank when
# the app is reached directly.
# TRUSTED_PROXIES=
